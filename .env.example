# ——— Base de données ———
# SQLite en local. Pour PostgreSQL : postgresql://user:password@localhost:5432/mkfit
DATABASE_URL="file:./dev.db"

# ——— NextAuth ———
# URL publique du site (sans slash final)
NEXTAUTH_URL="http://localhost:3000"
# Chaîne aléatoire longue : `openssl rand -base64 32`
NEXTAUTH_SECRET="remplacez-moi-par-une-chaine-aleatoire"

# ——— Stripe (mode test) ———
# Clés sur https://dashboard.stripe.com/test/apikeys
# Laissez STRIPE_SECRET_KEY vide pour utiliser le « mode démo » (paiement simulé).
STRIPE_SECRET_KEY=""
# Secret du webhook : `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# ——— Site ———
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ——— Seed (optionnel) ———
SEED_ADMIN_EMAIL="admin@mkfit.fr"
SEED_ADMIN_PASSWORD="Admin123!"
